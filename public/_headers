/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Build output is content-hashed, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated PNGs are stable but may change between deploys.
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.ico
  Cache-Control: no-cache, must-revalidate

/icon-32.png
  Cache-Control: no-cache, must-revalidate

/icon-64.png
  Cache-Control: no-cache, must-revalidate

/apple-icon-180.png
  Cache-Control: no-cache, must-revalidate

# Article covers only change when the article itself is replaced. They live
# outside /blog because the locale-less /blog/* redirect below would swallow them.
/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/about/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The service worker must never be served from a stale cache.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
